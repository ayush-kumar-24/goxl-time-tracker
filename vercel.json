{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [{ "source": "/", "destination": "/team", "permanent": false }],
  "rewrites": [{ "source": "/team", "destination": "/team/index.html" }],
  "headers": [
    { "source": "/team/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ]}
  ]
}
